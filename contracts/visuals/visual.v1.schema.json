{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meet-aule/aule-sw/contracts/visuals/visual.v1.schema.json",
  "title": "visual.v1",
  "description": "Something the tutor shows on the student's screen: an exercise to read or a simple diagram. It is a description, not a picture: each screen (a browser, the e-ink display) draws it itself, in black on white.",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "exercise",
        "fraction_bars",
        "fraction_circle",
        "number_line",
        "dot_array",
        "counters",
        "table",
        "bar_chart",
        "rectangle"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "A short caption above the drawing. Never the answer."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "description": "exercise: the statement, one short line each. Write numbers and operations with symbols here (3/4 + 1/4 = ?)."
    },
    "fractions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "fraction_bars (one bar per fraction) or fraction_circle (each drawn as a pie): the fractions to show.",
      "items": {
        "type": "object",
        "required": [
          "numerator",
          "denominator"
        ],
        "additionalProperties": false,
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "denominator": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      }
    },
    "from": {
      "type": "number",
      "description": "number_line: where the line starts."
    },
    "to": {
      "type": "number",
      "description": "number_line: where it ends. Greater than from."
    },
    "step": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "number_line: distance between ticks."
    },
    "marks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "number"
      },
      "description": "number_line: points to mark with a dot."
    },
    "jumps": {
      "type": "array",
      "maxItems": 6,
      "description": "number_line: arrows from one number to another, such as +3.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          }
        }
      }
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "dot_array: rows of dots."
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "dot_array: dots in each row."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "counters: groups of counters shown together, like a bag of balls. Each is a count and a fill, solid or open; give a label to name a group. For 5 red balls and 1 blue, a solid group of 5 and an open group of 1.",
      "items": {
        "type": "object",
        "required": [
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "fill": {
            "enum": [
              "solid",
              "open"
            ],
            "description": "solid filled or open outline; solid when left out."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      }
    },
    "headers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "description": "table: column headings."
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "table: rows of cells, as text. Use ? for a cell the student must find.",
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "string",
          "maxLength": 24
        }
      }
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "bar_chart: one bar per item.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "value": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "rectangle: its width."
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "rectangle: its height."
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "description": "rectangle: the unit of its sides, such as cm."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "exercise"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "lines"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fraction_bars"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "fractions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fraction_circle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "fractions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "number_line"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "from",
          "to",
          "step"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dot_array"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "rows",
          "columns"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "counters"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "groups"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "table"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "headers",
          "cells"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bar_chart"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "bars"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rectangle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "width",
          "height"
        ]
      }
    }
  ]
}
