{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meet-aule/aule-sw/contracts/visuals/visual.v1.schema.json",
  "title": "visual.v1",
  "description": "Something the tutor shows on the student's screen: an exercise to read or a simple diagram. It is a description, not a picture: each screen (a browser, the e-ink display) draws it itself, in black on white.",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "exercise",
        "fraction_bars",
        "fraction_circle",
        "number_line",
        "dot_array",
        "counters",
        "table",
        "bar_chart",
        "rectangle",
        "polygon",
        "clock"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "A short caption above the drawing. Never the answer."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "description": "exercise: the statement, one short line each. Write numbers and operations with symbols here (3/4 + 1/4 = ?)."
    },
    "fractions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "fraction_bars (one bar per fraction) or fraction_circle (each drawn as a pie): the fractions to show.",
      "items": {
        "type": "object",
        "required": [
          "numerator",
          "denominator"
        ],
        "additionalProperties": false,
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "denominator": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "labelled": {
            "type": "boolean",
            "description": "false draws the shape with nothing written next to it, for when the fraction is what the student has to find. Left out, the label is written, or the fraction itself when there is no label."
          }
        }
      }
    },
    "from": {
      "type": "number",
      "description": "number_line: where the line starts."
    },
    "to": {
      "type": "number",
      "description": "number_line: where it ends. Greater than from."
    },
    "step": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "number_line: distance between ticks."
    },
    "marks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "number"
      },
      "description": "number_line: points to mark with a dot."
    },
    "jumps": {
      "type": "array",
      "maxItems": 6,
      "description": "number_line: arrows from one number to another, such as +3.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          }
        }
      }
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "dot_array: rows of dots."
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "dot_array: dots in each row."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "counters: groups of counters shown together, like a bag of balls. Each is a count and a fill, solid or open; give a label to name a group. For 5 red balls and 1 blue, a solid group of 5 and an open group of 1.",
      "items": {
        "type": "object",
        "required": [
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "fill": {
            "enum": [
              "solid",
              "open"
            ],
            "description": "solid filled or open outline; solid when left out."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      }
    },
    "headers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "description": "table: column headings."
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "table: rows of cells, as text. Use ? for a cell the student must find.",
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "string",
          "maxLength": 24
        }
      }
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "bar_chart: one bar per item.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "value": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "rectangle: its width."
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "rectangle: its height."
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "description": "rectangle and polygon: the unit of the sides, such as cm."
    },
    "sides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "description": "polygon: a triangle from the lengths of its three sides, in this order: the base, the left side, the right side. Drawn to scale, so the longest must be shorter than the other two together."
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 12
      },
      "description": "polygon: what to write next to each side, in order, instead of its length: \"?\" for the side you are asking for, a name such as \"a\", or \"\" for nothing. With sides the order is base, left, right; with regular it starts at the bottom side and goes round; with points, side 1 joins the first two corners."
    },
    "regular": {
      "type": "integer",
      "minimum": 3,
      "maximum": 12,
      "description": "polygon: draw a regular one with this many equal sides (3 a triangle, 5 a pentagon, 6 a hexagon, 8 an octagon)."
    },
    "side": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "polygon, with regular: the length of each side, written next to the bottom one."
    },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      },
      "description": "polygon: any other shape (a trapezoid, a parallelogram, an L), as its corners in order around it, each [x, y] in the shape's own units with y upwards. Drawn to scale."
    },
    "hour": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "clock: the hour the short hand shows, 1 to 12. The hand is drawn between two numbers when minute is not 0, as on a real clock."
    },
    "minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 59,
      "description": "clock: the minutes the long hand shows; 0 when left out."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "exercise"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "lines"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fraction_bars"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "fractions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fraction_circle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "fractions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "number_line"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "from",
          "to",
          "step"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dot_array"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "rows",
          "columns"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "counters"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "groups"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "table"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "headers",
          "cells"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bar_chart"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "bars"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rectangle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "width",
          "height"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "polygon"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "regular"
            ]
          },
          {
            "required": [
              "sides"
            ]
          },
          {
            "required": [
              "points"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clock"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "hour"
        ]
      }
    }
  ]
}
