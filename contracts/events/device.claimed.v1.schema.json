{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meet-aule/capricorn-sw/contracts/events/device.claimed.v1.schema.json",
  "title": "device.claimed.v1",
  "description": "A family linked a device to its account by proving possession with the device's claim code. Produced by the platform.",
  "type": "object",
  "required": [
    "device_id",
    "family_id",
    "claimed_by",
    "hardware_revision"
  ],
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "family_id": {
      "type": "string",
      "format": "uuid"
    },
    "claimed_by": {
      "type": "string",
      "format": "uuid"
    },
    "hardware_revision": {
      "type": "string",
      "examples": [
        "capricorn-v0.2"
      ]
    },
    "firmware_version": {
      "type": "string"
    }
  }
}
