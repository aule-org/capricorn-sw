# Copy to .env (or point CAPRICORN_ENV_FILE at your copy) and fill it in.

# LiveKit server the agent connects to, and its API key pair.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent (apps/agent) ---
# Speech to text: assemblyai | deepgram | openai
CAPRICORN_STT=
# Text to speech: cartesia | elevenlabs | openai
CAPRICORN_TTS=
# Optional voice id of the chosen text-to-speech provider.
CAPRICORN_TTS_VOICE=
# Only the keys of the providers chosen above are needed.
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
OPENAI_API_KEY=
# Optional: defaults shown.
#CAPRICORN_AGENT_NAME=capricorn-tutor
#CAPRICORN_LLM_MODEL=claude-sonnet-5-5
#CAPRICORN_LANGUAGE=es
#CAPRICORN_SESSION_MAX_MINUTES=15

# --- Playground (apps/playground) ---
# LiveKit URL as the browser reaches it, when it differs from LIVEKIT_URL.
PLAYGROUND_LIVEKIT_URL=
# At least 16 characters. Whoever has it can start a session.
PLAYGROUND_ACCESS_CODE=
# Optional: defaults shown.
#PLAYGROUND_HOST=127.0.0.1
#PLAYGROUND_PORT=8090
#PLAYGROUND_BASE_PATH=/playground
#PLAYGROUND_SESSION_MINUTES=20
